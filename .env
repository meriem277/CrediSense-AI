# Variables de configuration de l'environnement
# Ne JAMAIS committer ce fichier dans Git (ajoute-le dans .gitignore)

# Dossier pour les fichiers uploadés par les clients
UPLOAD_DIR=./uploads

# Activer le GPU pour PaddleOCR (True/False)
USE_GPU=False

# Niveau de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=DEBUG

# Seuil de confiance minimum pour l'OCR (en dessous = warning)
MIN_OCR_CONFIDENCE=0.70