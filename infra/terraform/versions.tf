terraform {
  required_version = ">= 1.5"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 3.100"
    }
    tls = {
      source  = "hashicorp/tls"
      version = "~> 4.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }

  # Local state on purpose: fewer setup steps. Azure Cloud Shell keeps ~/ across
  # sessions, so state survives there. Keep terraform.tfstate private - it holds secrets.
}

provider "azurerm" {
  features {}
}
