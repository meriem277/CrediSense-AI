# cp terraform.tfvars.example terraform.tfvars   (terraform.tfvars is git-ignored)

groq_api_key = "gsk_..."

# Your GitHub owner in lowercase (used for first boot; deploy.yml keeps it in sync afterwards)
image_prefix = "ghcr.io/<github-owner>/credisense"

# Optional
# mistral_api_key  = ""
# gemini_api_key   = ""
# google_client_id = ""
# smtp_username    = "you@gmail.com"
# smtp_password    = "gmail-app-password"

